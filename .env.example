# 复制为项目根目录 .env 后按需修改；所有变量前缀 BAAS_
BAAS_DB_URL=sqlite+aiosqlite:///backend/baas_dev.db
# MySQL 示例: mysql+aiomysql://root:123123@127.0.0.1:3306/baas

BAAS_JWT_SECRET=dev-secret-change-me
BAAS_JWT_EXPIRES_MIN=120

BAAS_PUBLIC_BASE_URL=http://localhost:8000
BAAS_FRONTEND_BASE_URL=http://localhost:5173

BAAS_AUTH_BASE_URL=http://127.0.0.1:9001
BAAS_AUTH_CLIENT_ID=baas-web
BAAS_AUTH_CLIENT_SECRET=baas-web-secret

BAAS_LLM_PROVIDER=mock
BAAS_LLM_BASE_URL=http://127.0.0.1:9002
BAAS_LLM_MODEL=mock-attribution
BAAS_LLM_API_KEY=mock-key
